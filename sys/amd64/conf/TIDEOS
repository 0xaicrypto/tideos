#
# TideOS kernel configuration file
# Derived from GENERIC - retains full FreeBSD GENERIC driver set for now.
# Deep customization (nooptions/nodevice) will be added in later milestones.
#
include GENERIC

ident		TIDEOS

# VirtIO GPU: enables KMS/DRM in virtual machines (qemu/KVM virtio-vga),
# which is required for Wayland compositors and accelerated X11 in VMs.
device		virtio_gpu

