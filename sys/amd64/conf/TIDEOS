#
# TideOS kernel configuration file
# Derived from GENERIC - retains full FreeBSD GENERIC driver set for now.
# Deep customization (nooptions/nodevice) will be added in later milestones.
#
include GENERIC

ident		TIDEOS

# Note: virtio-gpu KMS/DRM support ships as a loadable module
# (drm-kmod virtio_gpu.ko, ported by TideOS).  The base-kernel
# "device virtio_gpu" is only a vt(4) console framebuffer driver and
# conflicts with the module, so it is intentionally NOT enabled here.

